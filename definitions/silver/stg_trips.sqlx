config {
    type: "incremental",
    description: "Staged bike trips with incremental processing and performance tuning",
    tags: ["medallion_silver", "mobility_trips", "daily"],
    bigquery: {
        partitionBy: "TIMESTAMP_TRUNC(start_time, DAY)",
        clusterBy: ["start_station_name", "subscriber_type"],
        requirePartitionFilter: true
    },
    columns: {
        trip_id: functions.common_columns.trip_id,
        subscriber_type: functions.common_columns.subscriber_type,
        start_time: functions.common_columns.start_time,
        duration_minutes: functions.common_columns.duration_minutes
    },
    assertions: {
        uniqueKey: ["trip_id"],
        nonNull: ["subscriber_type"],
        rowConditions: [
            "duration_minutes > 0",
            "TIMESTAMP_ADD(start_time, INTERVAL duration_minutes MINUTE) >= start_time"
        ]
    }
}

SELECT
    ${functions.generate_surrogate_key(["trip_id", "start_time"])} AS surrogate_key,
    trip_id,
    subscriber_type,
    bike_id,
    bike_type,
    start_time,
    duration_minutes,
    TIMESTAMP_ADD(start_time, INTERVAL duration_minutes MINUTE) AS end_time,
    start_station_id,
    start_station_name,
    end_station_id,
    end_station_name
FROM
    ${ref("bikeshare_trips")} ${when(dataform.projectConfig.vars.is_sandbox === "true", "TABLESAMPLE SYSTEM (10 PERCENT)")}
WHERE
    1 = 1
    ${when(incremental(), `AND start_time > (SELECT MAX(start_time) FROM ${self()})`)}
    ${when(dataform.projectConfig.vars.is_test_run === "true", `AND start_time >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 7 DAY)`)}
